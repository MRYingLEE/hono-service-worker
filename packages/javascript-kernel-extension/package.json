{
  "name": "@jupyterlite/javascript-kernel-extension",
  "version": "0.4.0-alpha.5",
  "description": "JupyterLite - JavaScript Kernel Extension",
  "homepage": "https://github.com/jupyterlite/javascript-kernel",
  "bugs": {
    "url": "https://github.com/jupyterlite/javascript-kernel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jupyterlite/javascript-kernel.git"
  },
  "license": "BSD-3-Clause",
  "author": "JupyterLite Contributors",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "directories": {
    "lib": "lib/"
  },
  "files": [
    "lib/*.d.ts",
    "lib/*.js.map",
    "lib/*.js"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:labextension:dev",
    "build:labextension": "node -e \"require('fs').mkdirSync('node_modules', { recursive: true })\" && jupyter-builder build .",
    "build:labextension:dev": "node -e \"require('fs').mkdirSync('node_modules', { recursive: true })\" && jupyter-builder build --development True .",
    "build:lib": "tsc -b && node ../javascript-kernel/src/build_lab_scripts.js ../../jupyterlite_javascript_kernel",
    "build:prod": "npm run clean && npm run build:lib && npm run build:labextension",
    "clean": "npm run clean:lib",
    "clean:all": "npm run clean:lib && npm run clean:dist && npm run clean:labextension && npm run clean:lab-scripts",
    "clean:dist": "rimraf dist",
    "clean:lab-scripts": "rimraf ../../jupyterlite_javascript_kernel/javascript-kernel-service-worker.js ../../jupyterlite_javascript_kernel/javascript-kernel-worker-runtime.js",
    "clean:labextension": "rimraf ../../jupyterlite_javascript_kernel/labextension",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "install:extension": "npm run build",
    "watch": "run-p watch:src watch:labextension",
    "watch:labextension": "jupyter-builder watch .",
    "watch:src": "tsc -w"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.6.0",
    "@jupyterlab/console": "^4.6.0",
    "@jupyterlab/notebook": "^4.6.0",
    "@jupyterlite/javascript-kernel": "^0.4.0-alpha.5",
    "@jupyterlite/services": "^0.8.0",
    "@lumino/disposable": "^2.1.5",
    "@lumino/signaling": "^2.1.5"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.0",
    "npm-run-all2": "^7.0.1",
    "rimraf": "~5.0.1",
    "typescript": "~5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "../../jupyterlite_javascript_kernel/labextension",
    "sharedPackages": {
      "@jupyterlite/javascript-kernel": {
        "singleton": true
      },
      "@jupyterlite/services": {
        "bundled": false,
        "singleton": true
      }
    }
  },
  "jupyterlite": {
    "liteExtension": true
  }
}
